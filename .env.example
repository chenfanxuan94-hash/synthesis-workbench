# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# AI drafts of effect rows (Effect sizes tab), through the Anthropic API. From console.anthropic.com -> API keys.
# Without it the app still works; the "Draft the rows with AI" button says it is not set up.
ANTHROPIC_API_KEY=
# Optional. Which model reads the papers. Defaults to claude-opus-5-5; claude-sonnet-5-5 is faster and cheaper.
ANTHROPIC_MODEL=
# Optional. How hard the model thinks: low, medium, high, xhigh or max. Defaults to medium.
ANTHROPIC_EFFORT=

# Optional. If set, the login page asks for this shared code once per browser.
# Leave blank for name-only login.
TEAM_CODE=

# Optional. Set to 1 to hide other people's votes on a paper until you have voted on it
# yourself (independent screening). Default: votes are visible to everyone.
BLIND_VOTES=
