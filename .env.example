# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Claude drafts of effect rows (Effect sizes tab). From console.anthropic.com -> API keys.
# Without it the app still works; the "Let Claude draft the rows" button says it is not set up.
ANTHROPIC_API_KEY=
# Optional. Which model reads the tables. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=

# Optional. If set, the login page asks for this shared code once per browser.
# Leave blank for name-only login.
TEAM_CODE=

# Optional. Set to 1 to hide other people's votes on a paper until you have voted on it
# yourself (independent screening). Default: votes are visible to everyone.
BLIND_VOTES=
